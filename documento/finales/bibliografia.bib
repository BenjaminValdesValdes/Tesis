}

@misc{schirrmacherBenchmarkingProbabilisticDeep2023,
  title = {Benchmarking {{Probabilistic Deep Learning Methods}} for {{License Plate Recognition}}},
  author = {Schirrmacher, Franziska and Lorch, Benedikt and Maier, Anatol and Riess, Christian},
  year = 2023,
  month = feb,
  number = {arXiv:2302.01427},
  eprint = {2302.01427},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2302.01427},
  urldate = {2026-07-05},
  abstract = {Learning-based algorithms for automated license plate recognition implicitly assume that the training and test data are well aligned. However, this may not be the case under extreme environmental conditions, or in forensic applications where the system cannot be trained for a specific acquisition device. Predictions on such out-of-distribution images have an increased chance of failing. But this failure case is oftentimes hard to recognize for a human operator or an automated system. Hence, in this work we propose to model the prediction uncertainty for license plate recognition explicitly. Such an uncertainty measure allows to detect false predictions, indicating an analyst when not to trust the result of the automated license plate recognition. In this paper, we compare three methods for uncertainty quantification on two architectures. The experiments on synthetic noisy or blurred low-resolution images show that the predictive uncertainty reliably finds wrong predictions. We also show that a multi-task combination of classification and super-resolution improves the recognition performance by 109\textbackslash\% and the detection of wrong predictions by 29 \%.},
  archiveprefix = {arXiv},
  orden = {48},
  keywords = {Computer Science - Computer Vision and Pattern Recognition},
  file = {C\:\\Users\\ezequ\\Zotero\\storage\\G6V29J54\\Schirrmacher et al. - 2023 - Benchmarking Probabilistic Deep Learning Methods for License Plate Recognition.pdf;C\:\\Users\\ezequ\\Zotero\\storage\\BB2YHA2J\\2302.html}
}

@article{sonnaraEfficientRealtimeLicense2025,
  title = {Efficient Real-Time License Plate Recognition Using Deep Learning on Edge Devices},
  author = {Sonnara, Fedi and Chihaoui, Hamadi and Filali, Fethi},
  year = 2025,
  month = jul,
  journal = {Journal of Real-Time Image Processing},
  volume = {22},
  doi = {10.1007/s11554-025-01738-3},
  abstract = {Real-time automatic license plate recognition (ALPR) is essential for smart-traffic, tolling, parking, and policing, yet roadside cameras must run on \textbackslash documentclass[12pt]\textbraceleft minimal\textbraceright{} \textbackslash usepackage\textbraceleft amsmath\textbraceright{} \textbackslash usepackage\textbraceleft wasysym\textbraceright{} \textbackslash usepackage\textbraceleft amsfonts\textbraceright{} \textbackslash usepackage\textbraceleft amssymb\textbraceright{} \textbackslash usepackage\textbraceleft amsbsy\textbraceright{} \textbackslash usepackage\textbraceleft mathrsfs\textbraceright{} \textbackslash usepackage\textbraceleft upgreek\textbraceright{} \textbackslash setlength\textbraceleft\textbackslash oddsidemargin\textbraceright\textbraceleft -69pt\textbraceright{} \textbackslash begin\textbraceleft document\textbraceright\$\${$<\backslash$}!10\$\$\textbackslash end\textbraceleft document\textbraceright{} W hardware with limited memory and patchy connectivity, ruling out cloud off-loading. These constraints demand compact, fast models resilient to oblique views, motion blur, glare, and diverse plate styles. We introduce Light-Edge, a single-pass deep network that jointly localizes plates and recognizes characters. It shares a ResNet-18 + FPN backbone, removes 28 \% of convolutions with a \textbackslash documentclass[12pt]\textbraceleft minimal\textbraceright{} \textbackslash usepackage\textbraceleft amsmath\textbraceright{} \textbackslash usepackage\textbraceleft wasysym\textbraceright{} \textbackslash usepackage\textbraceleft amsfonts\textbraceright{} \textbackslash usepackage\textbraceleft amssymb\textbraceright{} \textbackslash usepackage\textbraceleft amsbsy\textbraceright{} \textbackslash usepackage\textbraceleft mathrsfs\textbraceright{} \textbackslash usepackage\textbraceleft upgreek\textbraceright{} \textbackslash setlength\textbraceleft\textbackslash oddsidemargin\textbraceright\textbraceleft -69pt\textbraceright{} \textbackslash begin\textbraceleft document\textbraceright\$\$1\textbackslash times 1\$\$\textbackslash end\textbraceleft document\textbraceright{} channel-fusion block, and replaces anchors with an anchor-free head followed by a CTC decoder. After mixed-precision compilation in Torch-TensorRT, the 38 MB model sustains 14 FPS on a Jetson Nano---73 \% faster than the anchor-free AF-Net (8.1 FPS) and 49 \% faster than YOLOv8-MobileLPR (9.5 FPS)---while keeping competitive accuracy (90.2 \% mAP) and halving AF-Net's power consumption (4.8 W vs 8.8 W). Light-Edge therefore satisfies the stringent speed--accuracy envelope required for large-scale, privacy-preserving ALPR on resource-constrained edge devices.},
  orden = {12},
