@article{ammarMultiStageDeepLearningBasedVehicle2023,
  title = {A {{Multi-Stage Deep-Learning-Based Vehicle}} and {{License Plate Recognition System}} with {{Real-Time Edge Inference}}},
  author = {Ammar, Adel and Koubaa, Anis and Boulila, Wadii and Benjdira, Bilel and Alhabashi, Yasser},
  year = 2023,
  month = jan,
  journal = {Sensors},
  volume = {23},
  number = {4},
  pages = {2120},
  publisher = {Multidisciplinary Digital Publishing Institute},
  issn = {1424-8220},
  doi = {10.3390/s23042120},
  urldate = {2026-07-05},
  abstract = {Video streaming-based real-time vehicle identification and license plate recognition systems are challenging to design and deploy in terms of real-time processing on edge, dealing with low image resolution, high noise, and identification. This paper addresses these issues by introducing a novel multi-stage, real-time, deep learning-based vehicle identification and license plate recognition system. The system is based on a set of algorithms that efficiently integrate two object detectors, an image classifier, and a multi-object tracker to recognize car models and license plates. The information redundancy of Saudi license plates' Arabic and English characters is leveraged to boost the license plate recognition accuracy while satisfying real-time inference performance. The system optimally achieves real-time performance on edge GPU devices and maximizes models' accuracy by taking advantage of the temporally redundant information of the video stream's frames. The edge device sends a notification of the detected vehicle and its license plate only once to the cloud after completing the processing. The system was experimentally evaluated on vehicles and license plates in real-world unconstrained environments at several parking entrance gates. It achieves 17.1 FPS on a Jetson Xavier AGX edge device with no delay. The comparison between the accuracy on the videos and on static images extracted from them shows that the processing of video streams using this proposed system enhances the relative accuracy of the car model and license plate recognition by 13\% and 40\%, respectively. This research work has won two awards in 2021 and 2022.},
  copyright = {http://creativecommons.org/licenses/by/3.0/},
  langid = {english},
  orden = {36},
  keywords = {computer vision,deep learning,license plate recognition,tracking,vehicle identification,video analytics},
  file = {C:\Users\ezequ\Zotero\storage\VFMZCHBM\Ammar et al. - 2023 - A Multi-Stage Deep-Learning-Based Vehicle and License Plate Recognition System with Real-Time Edge I.pdf}
}

