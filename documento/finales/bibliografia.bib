@article{oluwaseyiComparativeAnalysisYOLOv52025,
  title = {A Comparative Analysis of {{YOLOv5}}, {{YOLOv8}}, and {{YOLOv10}} for Balancing Accuracy and Speed for Real-Time Vehicle Detection},
  author = {Oluwaseyi, Olorunshola and Iheagwara, Stephen and Lakan, Nanji and Akanbi, Aisha},
  year = 2025,
  month = nov,
  journal = {Nature Journal of Emerging Sciences Technologies and Innovations},
  volume = {3},
  pages = {117--130},
  doi = {10.65752/wb2sep51},
  abstract = {The need for real-time and reliable vehicle detection in dynamic traffic environments is increasingly critical for applications such as autonomous driving, smart traffic monitoring, and surveillance systems. While many existing object detection models excel either in accuracy or in speed, few maintain a consistent balance between the two. This study proposes a lightweight, GPU-efficient system for vehicle detection and conducts a comparative analysis of three popular YOLO-based deep learning models, YOLOv5s, YOLOv8s, and YOLOv10s, using the UA-DETRAC dataset to determine which best balances detection accuracy and inference speed. The dataset was preprocessed to include only relevant vehicle classes (car, van, and bus), and each model was trained using consistent hyperparameter settings. Evaluation metrics included mean average precision, mAP@0.5, mAP@0.5:0.95, precision, recall, and frames per second (FPS). YOLOv5s demonstrated superior inference speed (\textasciitilde 92 FPS), making it suitable for latency-critical applications, though with slightly reduced precision. YOLOv8s offered a balanced trade-off with improved localization accuracy and moderate speed (\textasciitilde 83 FPS). YOLOv10s achieved the highest mAP scores and robustness across all classes, maintaining acceptable speed (\textasciitilde 66 FPS), and was selected as the core model for the proposed system in high-accuracy real-time deployments. Overall, this work presents amicable insights on the tradeoffs offered by the different YOLO variants for vehicle detection system to ensure dependable performance across varying computational constraints.},
  orden = {18},
  file = {C:\Users\ezequ\Zotero\storage\93U4XSGE\Oluwaseyi et al. - 2025 - A comparative analysis of YOLOv5, YOLOv8, and YOLOv10 for balancing accuracy and speed for real-time.pdf}
}

