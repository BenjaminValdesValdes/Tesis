@article{salsabilaEnhancingAutomatedVehicle2024,
  title = {Enhancing {{Automated Vehicle License Plate Recognition}} with {{YOLOv8}} and {{EasyOCR}}},
  author = {Salsabila, Nurul and Sriani, Sriani},
